# ==============================================================================
# AI RESUME ATS — Environment Variables Template
# Copy this file to .env for local development or configure in your deployment platform
# ==============================================================================

# ------------------------------------------------------------------------------
# Supabase Configuration
# Found in: Supabase Dashboard -> Project Settings -> API
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_service_role_secret_key
SUPABASE_ANON_KEY=your_supabase_anon_public_key

# Found in: Supabase Dashboard -> Project Settings -> API -> JWT Settings -> JWT Secret
SUPABASE_JWT_SECRET=your_supabase_jwt_secret

# ------------------------------------------------------------------------------
# Groq LLM API Configuration
# Get your API key from https://console.groq.com/keys
# ------------------------------------------------------------------------------
GROQ_API_KEY=gsk_your_groq_api_key_here

# ------------------------------------------------------------------------------
# Frontend Configuration (Used by Streamlit)
# In Streamlit Cloud, add these to App Settings -> Secrets
# ------------------------------------------------------------------------------
# Point this to your live backend URL (e.g. on Render or Hugging Face Spaces)
BACKEND_URL=https://your-backend-app.onrender.com

# URL of your Streamlit app for Google OAuth redirect
AUTH_REDIRECT_URL=https://your-app.streamlit.app

# ------------------------------------------------------------------------------
# Backend Server Configuration (Optional)
# ------------------------------------------------------------------------------
PORT=8000
ENVIRONMENT=production
ALLOWED_ORIGINS=https://your-app.streamlit.app,http://localhost:8501
SPACY_MODEL_PRIMARY=en_core_web_sm
SENTENCE_TRANSFORMER_MODEL=all-MiniLM-L6-v2
